+
+  private func getCumulativeKilocalories(
+    identifier: HKQuantityTypeIdentifier, startDate: Date, endDate: Date
+  ) async throws -> Double {
+    let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)
+
+    return try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsQuery(
+        quantityType: HKQuantityType.quantityType(forIdentifier: identifier)!,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum
+      ) { _, result, error in
+        if let error = error {
+          let nsError = error as NSError
+          // HealthKit deliberately reports read-permission denial as "no data".
+          // Mirror that for these best-effort energy reads instead of surfacing
+          // an error the UI can't act on. Real failures still propagate.
+          let benign: Set<Int> = [
+            HKError.Code.errorAuthorizationDenied.rawValue,
+            HKError.Code.errorAuthorizationNotDetermined.rawValue,
+            HKError.Code.errorNoData.rawValue,
+          ]
+          if nsError.domain == HKError.errorDomain && benign.contains(nsError.code) {
+            continuation.resume(returning: 0)
+          } else {
+            continuation.resume(
+              throwing: HealthKitError.queryFailed(
+                "\(nsError.domain) \(nsError.code): \(nsError.localizedDescription)"))
+          }
+          return
+        }
+
+        let kcal = result?.sumQuantity()?.doubleValue(for: .kilocalorie()) ?? 0
+        continuation.resume(returning: kcal)
+      }
+
+      healthStore.execute(query)
+    }
+  }
