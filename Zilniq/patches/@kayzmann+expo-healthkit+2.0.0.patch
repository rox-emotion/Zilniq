+/**
+ * Get total active energy burned (Apple Health "Active Energy") for a date range
+ * @param startDate - Start date
+ * @param endDate - End date
+ * @returns Active energy burned in kilocalories
+ */
+export async function getActiveEnergyBurned(
+  startDate: Date,
+  endDate: Date
+): Promise<number> {
+  const start = startDate.getTime() / 1000;
+  const end = endDate.getTime() / 1000;
+  return await ExpoHealthKitModule.getActiveEnergyBurned(start, end);
+}
+
+/**
+ * Get total basal (resting) energy burned (Apple Health "Resting Energy") for a date range
+ * @param startDate - Start date
+ * @param endDate - End date
+ * @returns Basal energy burned in kilocalories
+ */
+export async function getBasalEnergyBurned(
+  startDate: Date,
+  endDate: Date
+): Promise<number> {
+  const start = startDate.getTime() / 1000;
+  const end = endDate.getTime() / 1000;
+  return await ExpoHealthKitModule.getBasalEnergyBurned(start, end);
+}
